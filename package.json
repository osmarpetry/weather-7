{
  "name": "weather-7",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-pwa-icons.mjs && next build",
    "start": "next start",
    "generate": "plop --plopfile generators/plopfile.js",
    "lint": "eslint src --max-warnings=0",
    "prettier": "prettier --write \"./**/*.{ts,tsx,js,jsx,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "lint-staged": {
    "src/**/*": [
      "pnpm exec eslint --fix --max-warnings=0",
      "pnpm exec prettier --write"
    ]
  },
  "dependencies": {
    "next": "13.1.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "styled-components": "^6.5.3",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-typescript": "7.29.7",
    "@happy-dom/global-registrator": "^20.14.5",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/builder-webpack5": "6.5.16",
    "@storybook/manager-webpack5": "6.5.16",
    "@storybook/react": "8.1.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.2",
    "@types/react": "18.0.27",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "babel-loader": "10.1.1",
    "babel-plugin-styled-components": "2.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "plop": "^4.0.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.1"
  }
}
